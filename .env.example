APP_ENV=development
# Native Mode defaults. Relative paths are resolved from the project root.
DATABASE_URL=sqlite+aiosqlite:///./data/csl_trading_lab.db
DATA_DIR=./data
MOCK_MODE=true
TRADING_ENABLED=false
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_REST_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2
CSL_SERIES_TICKERS=
DISCOVERY_INTERVAL_SECONDS=3
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
PUBLIC_ORIGIN=https://csltradinglab.duckdns.org
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
ADMIN_PASSWORD_HASH=
AUTH_SESSION_HOURS=12
AUTH_REMEMBER_DAYS=30
ADMIN_REAUTH_MINUTES=15
AUTO_DISCOVERY_ENABLED=false
MATCH_CONFIG_PATH=./config/matches.v1.json
REALTIME_SIGNAL_MAX_AGE_MS=5000
