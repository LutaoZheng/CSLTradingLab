KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2
CSL_SERIES_TICKERS=
DISCOVERY_INTERVAL_SECONDS=3
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
